---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

const siteName = 'Chaötic!';
const description = "Page not found — but the story's still here. Head back to the chapter list for Chaötic!.";
const canonicalURL = new URL('/404', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <SiteHead pageTitle={`Page not found | ${siteName}`} description={description} canonicalURL={canonicalURL} ogType="website" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <Header />

    <main>
      <section class="prose-page">
        <div class="wrap">
          <h1 class="page-title">404 — Page not found</h1>
          <div class="prose">
            <p>That page doesn't exist, or it moved.</p>
            <p><a href="/">Back to the chapter list</a> or <a href="/about">learn more about the story</a>.</p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
