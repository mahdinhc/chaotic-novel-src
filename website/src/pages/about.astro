---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

const siteName = 'Chaötic!';
const description = `About ${siteName} — a serialized novel following high schooler Tokio Yukawa after he's dragged into a shadow war between a masked vigilante crew and a terrorist organization.`;
const canonicalURL = new URL('/about', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <SiteHead pageTitle={`About | ${siteName}`} description={description} canonicalURL={canonicalURL} ogType="website" />
  </head>
  <body>
    <Header current="about" />

    <main>
      <section class="prose-page">
        <div class="wrap">
          <h1 class="page-title">About</h1>
          <div class="prose">
            <p>
              <em>Chaötic!</em> is a serialized novel set in and around North City
              during the summer of 2016. It follows Tokio Yukawa — a bored,
              sharp-tongued high schooler with a habit of finishing everyone
              else's homework — after a late-night walk home takes a detour he
              didn't ask for.
            </p>
            <p>
              What starts as a bizarre encounter with a masked group calling
              themselves the Phantoms quickly spirals into something bigger:
              a shadow conflict against a terrorist organization known as
              Abyss. Between school, part-time jobs, and the occasional
              firefight, Tokio and the people around him have to figure out
              who to trust — and how far they're willing to go.
            </p>
            <p>
              Expect action, dark humor, a cast of morally questionable kids
              with too much free time, and the slow unraveling of a conspiracy
              that reaches further than anyone realizes. New chapters release
              in reading order; the chapter list updates the moment something
              new drops.
            </p>

            <h2>About the author</h2>
            <p>
              Amidorphin is a writer, artist, musician, game developer, and
              programmer. <em>Chaötic!</em> is one part of a larger creative
              project known as <strong>Project CHAÖS!</strong>, which spans
              multiple mediums and formats.
            </p>
            <p>
              Amidorphin's novels are published across several platforms,
              including <strong>Honeyfeed</strong>, <strong>WebNovel</strong>,
              and <strong>Wattpad</strong>. The story is also available to read
              on Wattpad under the title <em>CHAÖTIC!</em>.
            </p>
            <p>
              You can find Amidorphin's work, social links, and updates via
              <a href="https://linktr.ee/amidorphin" target="_blank" rel="noopener noreferrer">Linktree</a>.
              Other platforms include <strong>X</strong> (Twitter) and
              <strong>YouTube</strong>, where project updates and related
              content are shared.
            </p>

            <h2>Updates</h2>
            <p>
              New chapters appear on the chapter list as soon as they're
              published, in reading order.
            </p>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>