---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteHead from '../components/SiteHead.astro';

interface Props {
  title: string;
  chapter: string;
  volume: number;
  description: string;
  slug: string;
  prev?: { slug: string; label: string } | null;
  next?: { slug: string; label: string } | null;
}

const { title, chapter, volume, description, slug, prev, next } = Astro.props;

const siteName = 'Chaötic!';
const pageTitle = `Chapter ${chapter}: ${title} | ${siteName}`;
const canonicalURL = new URL(`/chapters/${slug}`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <SiteHead pageTitle={pageTitle} description={description} canonicalURL={canonicalURL} ogType="article" />
  </head>
  <body>
    <div class="progress-track" aria-hidden="true">
      <div class="progress-bar" id="reading-progress"></div>
    </div>

    <Header current="home" />

    <main>
      <div class="wrap">
        <article>
          <header class="chapter-header">
            <p class="chapter-eyebrow">Volume {volume} &middot; Chapter {chapter}</p>
            <h1 class="chapter-title">{title}</h1>
          </header>

          <div class="chapter-body">
            <slot />
          </div>

          <p class="chapter-end">End of chapter</p>
        </article>

        <nav class="chapter-nav" aria-label="Chapter navigation">
          <span class="nav-prev">
            {prev && (
              <a class="nav-link" href={`/chapters/${prev.slug}`}>
                <span class="nav-label">Previous</span>
                &larr; {prev.label}
              </a>
            )}
          </span>
          <a class="nav-all" href="/">All chapters</a>
          <span class="nav-next">
            {next && (
              <a class="nav-link" href={`/chapters/${next.slug}`}>
                <span class="nav-label">Next</span>
                {next.label} &rarr;
              </a>
            )}
          </span>
        </nav>
      </div>
    </main>

    <Footer />

    <script>
      const bar = document.getElementById('reading-progress');
      function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (bar) bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
      }
      document.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
    </script>
  </body>
</html>
